{
  "name": "spawn",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "chain": "npm --prefix contracts run node",
    "chain:deploy": "npm --prefix contracts run deploy:local",
    "chain:bots": "npm --prefix contracts run bots",
    "chain:test": "npm --prefix contracts test",
    "test:functions": "node --test \"netlify/lib/*.test.mjs\""
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "viem": "^2.57.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "tailwindcss": "^4.1.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
